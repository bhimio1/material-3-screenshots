# Maintainer: bhimio1
pkgname=material-3-screenshots-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Material 3 screenshots, annotation editor and screen recorder for Hyprland"
arch=('x86_64' 'aarch64')
url="https://github.com/bhimio1/material-3-screenshots"
license=('MIT')
depends=('libxkbcommon' 'wayland' 'libglvnd' 'grim' 'slurp' 'wl-clipboard')
makedepends=('cargo' 'git')
optdepends=(
  'hyprland: window and output selection (hyprctl)'
  'hyprpicker: show the frozen screen while selecting'
  'gpu-screen-recorder: screen recording (preferred)'
  'wf-recorder: screen recording'
  'libpulse: recording audio with wf-recorder (pactl)'
  'pipewire: shutter sound (pw-play)'
  'sound-theme-freedesktop: the shutter sound'
  'ffmpegthumbnailer: thumbnails of recordings in History'
)
provides=('material-3-screenshots')
conflicts=('material-3-screenshots' 'material-3-screenshots-bin')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/m3-screenshots "$pkgdir/usr/bin/m3-screenshots"
  install -Dm644 packaging/material_3_screenshots.desktop "$pkgdir/usr/share/applications/material_3_screenshots.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/fonts/LICENSE-Inter.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Inter.txt"
}
